{
  "manifest_version": 3,
  "name": "my-own-collection Vinted publisher",
  "version": "0.1.0",
  "description": "Works the my-own-collection publish queue in your own logged-in Vinted tab. Dry-run by default.",
  "key": "",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8100/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.vinted.nl/*"
      ],
      "js": [
        "recipe.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Vinted publisher",
    "default_popup": "popup.html"
  }
}